<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient glow behind the Gemini star -->
    <path
        android:pathData="M54,54m-26,0a26,26 0 1,1 52,0a26,26 0 1,1 -52,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="radial"
                android:gradientRadius="26">
                <item android:offset="0.0" android:color="#4D4285F4" />
                <item android:offset="0.6" android:color="#269B72CF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Gemini 4-pointed Sparkle Star -->
    <path
        android:pathData="M54,24 C54,40.5 40.5,54 24,54 C40.5,54 54,67.5 54,84 C54,67.5 67.5,54 84,54 C67.5,54 54,40.5 54,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="24"
                android:endX="84"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#24C1E0" />
                <item android:offset="0.35" android:color="#4285F4" />
                <item android:offset="0.7" android:color="#9B72CF" />
                <item android:offset="1.0" android:color="#FA5D75" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Small accent sparkle star top-right -->
    <path
        android:pathData="M78,24 C78,30 72,36 66,36 C72,36 78,42 78,48 C78,42 84,36 90,36 C84,36 78,30 78,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="66"
                android:startY="24"
                android:endX="90"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.5" android:color="#A6C8FF" />
                <item android:offset="1.0" android:color="#D2B5FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

